# MongoDB Atlas - Replace user_name, password, dbname
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.henijym.mongodb.net/fertilizer-shop?retryWrites=true&w=majority

# NextAuth - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# For Local
NEXTAUTH_URL=http://localhost:3000

# For Vercel Production (uncomment and replace after deploy)
# NEXTAUTH_URL=https://your-app-name.vercel.app